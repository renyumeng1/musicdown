/* Modern light theme (Fusion recommended) */

QMainWindow,
QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", Arial, sans-serif;
    font-size: 12px;
}

QLabel {
    color: #0f172a;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QComboBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #22c55e;
    selection-color: #052e16;
}

QComboBox {
    padding-right: 32px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #e5e7eb;
    background: #f1f5f9;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QComboBox::drop-down:hover {
    background: #e2e8f0;
}

QComboBox::down-arrow {
    image: url("icons/chevron-down.svg");
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #e5e7eb;
    selection-background-color: rgba(34, 197, 94, 0.12);
    selection-color: #0f172a;
    outline: 0;
}

QListView {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 6px;
    outline: 0;
}

QListView::item {
    padding: 8px 10px;
    border-radius: 8px;
}

QListView::item:hover {
    background: rgba(15, 23, 42, 0.04);
}

QListView::item:selected {
    background: rgba(34, 197, 94, 0.18);
    color: #0f172a;
}

QMenu {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 12px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: rgba(34, 197, 94, 0.18);
    color: #0f172a;
}

QMenu::separator {
    height: 1px;
    background: #e5e7eb;
    margin: 6px 8px;
}

QSpinBox {
    padding-right: 32px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    border-top-right-radius: 10px;
    background: #f1f5f9;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    border-left: 1px solid #e5e7eb;
    border-bottom-right-radius: 10px;
    background: #f1f5f9;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background: #e2e8f0;
}

QSpinBox::up-arrow,
QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow {
    image: url("icons/chevron-up.svg");
}

QSpinBox::down-arrow {
    image: url("icons/chevron-down.svg");
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #22c55e;
}

QPushButton {
    background-color: #22c55e;
    color: #052e16;
    border: none;
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #16a34a;
}

QPushButton:pressed {
    background-color: #15803d;
}

QPushButton:disabled {
    background-color: #e5e7eb;
    color: #94a3b8;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background: #ffffff;
    color: #64748b;
    padding: 10px 14px;
    margin-right: 6px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QTabBar::tab:selected {
    background: #f1f5f9;
    color: #0f172a;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    gridline-color: #e5e7eb;
    selection-background-color: rgba(34, 197, 94, 0.12);
    selection-color: #0f172a;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #0f172a;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #e5e7eb;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QProgressBar {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-align: center;
    color: #0f172a;
}

QProgressBar::chunk {
    background-color: #22c55e;
    border-radius: 10px;
}
